# 默认按文本处理，由 Git 自动判断是否为二进制
* text=auto

# 源码、配置与文档统一 LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
gradlew text eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.ab binary
*.dds binary
*.wav binary
*.mp3 binary
*.ogg binary
